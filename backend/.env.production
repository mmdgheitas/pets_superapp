# ===== App =====
NODE_ENV=development
PORT=3000
# Comma separated list of allowed CORS origins (web app, admin panel)
CORS_ORIGINS=https://petshop.example.ir
# URL of the Next.js web app (used for payment gateway callback redirects)
WEB_APP_URL=http://localhost:3001

# ===== Database (MySQL 8) =====
DATABASE_URL=mysql://pets:REQUIRED_DB_PASSWORD@mysql:3306/pets_superapp

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=pets:

# ===== JWT =====
JWT_ACCESS_SECRET=REQUIRED_GENERATE_STRONG_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=REQUIRED_GENERATE_STRONG_SECRET
JWT_REFRESH_EXPIRES=7d

# ===== OTP =====
OTP_LENGTH=5
OTP_EXPIRY_SECONDS=120
# max OTP requests per phone in OTP_RATE_WINDOW_SECONDS
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW_SECONDS=600
# Set to true to skip SMS delivery and log the OTP instead (local dev without KaveNegar)
KAVENEGAR_MOCK=false
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# Kavenegar verify-lookup template name for OTP (create it in Kavenegar panel)
KAVENEGAR_OTP_TEMPLATE=pets-verify

# ===== Payments (ZarinPal primary) =====
ZARINPAL_MERCHANT_ID=REQUIRED_SET_REAL_MERCHANT_ID
ZARINPAL_SANDBOX=false
# Backup gateway (IDPay) - not used in Phase 1
IDPAY_API_KEY=
IDPAY_SANDBOX=true
# Marketplace commission in percent applied when a seller has no custom rate
DEFAULT_COMMISSION_RATE=5
# Auto-cancel unpaid orders after this many minutes
ORDER_PAYMENT_TIMEOUT_MINUTES=15
# Flat shipping fee in IRR
SHIPPING_FEE_IRR=750000

# ===== ArvanCloud Object Storage (S3 compatible) =====
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_BUCKET=pets-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public CDN base URL for uploaded files
PUBLIC_FILE_BASE_URL=https://pets-uploads.cdn.ir
# mock = do not call S3, return fake URLs (local dev)
UPLOAD_DRIVER=s3
MAX_UPLOAD_MB=5

# ===== Firebase (push notifications) =====
# Leave empty to disable FCM in development
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===== Email (Nodemailer / SMTP) =====
# Leave SMTP_HOST empty to log emails instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PetShop <no-reply@petshop.ir>"

# ===== Logging =====
LOG_LEVEL=info
